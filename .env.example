# =====================================================
# STREAMSTICKPRO ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your values
# For Cloudflare: Add these in Dashboard → Settings → Environment Variables
# =====================================================

# =====================================================
# DATABASE (PostgreSQL - Supabase)
# =====================================================
# Get from Supabase Dashboard → Settings → Database → Connection string (URI)
# Make sure to add ?sslmode=require at the end
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require

# =====================================================
# STRIPE (Payment Processing)
# =====================================================
# Get from https://dashboard.stripe.com/apikeys
# Use TEST keys for development, LIVE keys for production

# Secret key - NEVER expose this to frontend
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxx

# Publishable key - safe for frontend
STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxx

# Webhook signing secret - Get when creating webhook endpoint
# Dashboard → Developers → Webhooks → Add endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx

# Optional ONN kit Stripe Price IDs (one-time $150 / $160 in Stripe Dashboard).
# When set on the Worker/Pages project, checkout uses these BEFORE WordPress CMS maps and BEFORE Supabase shadow_price_id.
# Same vars apply to the main site and secure/cloaked host — critical for matching displayed prices to Stripe charges.
# STRIPE_PRICE_ONN_GOOGLE_HD=price_xxxxxxxxxxxxxxxxxxxxxxxx
# STRIPE_PRICE_ONN_GOOGLE_4K=price_yyyyyyyyyyyyyyyyyyyyyyyy
# Optional JSON map for any real_products.id -> price_... (merged with the two vars above):
# STRIPE_PRICE_MAP_JSON={"onn-google-hd":"price_xxx","onn-google-4k":"price_yyy"}

# =====================================================
# RESEND (Email Service)
# =====================================================
# Get from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxx

# Your verified domain email (verify domain in Resend dashboard first)
RESEND_FROM_EMAIL=noreply@yourdomain.com

# =====================================================
# SUPABASE (Image Storage)
# =====================================================
# Get from Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://emlqlmfzqsnqokrqvmcm.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Storage bucket name (create in Supabase → Storage)
VITE_STORAGE_BUCKET_NAME=imiges

# Service role key - NEVER expose to frontend (server-only)
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# =====================================================
# GITHUB (Optional - for Git operations)
# =====================================================
# Create at https://github.com/settings/tokens
GITHUB_TOKEN=ghp_xxxxxxxxxxxxx

# =====================================================
# CLOUDFLARE (for deploy and optional cache purge)
# =====================================================
# GitHub Secrets only (never in code). Used by deploy workflow.
# CLOUDFLARE_API_TOKEN - Cloudflare API token (Edit Workers, Read account)
# CLOUDFLARE_ACCOUNT_ID - Cloudflare account ID
# CLOUDFLARE_ZONE_ID - (optional) Zone ID for cache purge after deploy

# =====================================================
# APPLICATION SETTINGS
# =====================================================
# Session encryption secret (generate a random 64-character string)
SESSION_SECRET=your-random-64-character-secret-key-here

# Production URL (your custom domain)
BASE_URL=https://streamstickpro.com

# Shadow store domain (for Stripe display)
VITE_SECURE_HOSTS=secure.streamstickpro.com

# Node environment
NODE_ENV=production

# =====================================================
# GOOGLE ADS (optional — conversion tracking in UI build)
# =====================================================
# Get from: Google Ads → Tools → Measurement → Conversions → select Purchase → Tag setup
# The conversion label is the token shown after "send_to: AW-xxxxx/THIS_PART"
# Set in Cloudflare Pages → Settings → Environment variables (Vite requires rebuild)
VITE_GOOGLE_ADS_ID=AW-xxxxxxxxxxxxx
VITE_GOOGLE_ADS_CONVERSION_LABEL=AbCdEfGhIjKlMnOpQrSt
